    "prewarm": "tsx scripts/prewarm.ts",
    "build-snapshot": "tsx scripts/build-snapshot.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "d3-force": "^3.0.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-force-graph-2d": "^1.29.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
